<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Platform-specific TFM (not plain net10.0-windows) so the WinRT toast
         APIs (Windows.UI.Notifications) are projected for the OS-scheduled
         alarm toasts. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The WebView2 package's targets reference both its WinForms and WPF assemblies
         for net5.0+ TFMs regardless of UseWPF; with UseWindowsForms=true that surfaces
         MSB3277 (WindowsBase 4.0 vs 5.0 unification). The WPF assembly is never used
         here — the conflict is benign and suppressed. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**\*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The React bundle: `npm run build` in ui\ produces ui\dist, which ships
       beside the exe and is served to WebView2 via the vibealarm.app virtual
       host mapping (never file://). Not committed to source control — build it
       with `npm ci &amp;&amp; npm run build` from ui\. -->
  <ItemGroup>
    <Content Include="ui\dist\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="ui\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The installer build script stages a generated installer project under
       build_staging\ (and dotnet publish output under publish\), the xUnit test
       project lives under tests\, and the shared backend library under src\.
       Exclude them from the default .cs glob. NOTE: the React SPA folder (ui\)
       must NOT be excluded here — MSBuild globs are case-insensitive on Windows,
       so "ui\**" would also remove the host's UI\ sources. The SPA contains no
       .cs files, so no exclusion is needed. -->
  <ItemGroup>
    <Compile Remove="build_staging\**" />
    <Compile Remove="publish\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="src\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared backend + theming core (scheduler, storage, settings, audio,
         accent catalog) consumed by this host. -->
    <ProjectReference Include="src\VibeAlarm.Core\VibeAlarm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

</Project>
