<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Explicitly marks this as a test project so the SDK / Visual Studio treat it as a
         test assembly (test host + Test Explorer), never as a runnable application. This
         is what prevents VS from "running" VibeAlarm.Tests.dll like an executable (F5). -->
    <IsTestProject>true</IsTestProject>
    <!-- Do not inherit the WinForms app's Assets copy glob / default Content items. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- v17.14.x is the Test SDK aligned with the .NET 10 SDK/runtime (this project targets
         net10.0-windows). 17.11 predates .NET 10 and provides no net10.0 test host. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VibeAlarm.csproj" />
  </ItemGroup>

</Project>